{
  "name": "flowplan-desktop",
  "productName": "FlowPlan",
  "version": "1.0.3",
  "description": "FlowPlan — Daily, Weekly & Monthly Planner with Focus & Pomodoro Timer",
  "main": "main.js",
  "scripts": {
    "clean": "node -e \"try { require('fs').rmSync('dist', { recursive: true, force: true }); } catch (e) {}\"",
    "predist": "npm run clean",
    "predist:win": "npm run clean",
    "dev": "electron . --dev",
    "start:dev": "electron . --dev",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.flowplan.desktop",
    "productName": "FlowPlan",
    "asar": false,
    "files": [
      "daily_weekly_planner.html",
      "main.js",
      "package.json",
      "assets/**/*",
      "node_modules/three/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DrHamdii",
        "repo": "FlowPlan"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "three": "^0.186.1"
  }
}